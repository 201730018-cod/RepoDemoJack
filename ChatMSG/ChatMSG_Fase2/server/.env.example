# Copia este archivo como .env y llena los valores

# Puerto de este servidor (cada compañero usa uno diferente)
PORT=3001

# URL de Redis (si usan Redis Cloud, pegan la URL aquí)
# Ejemplo Redis Cloud: redis://default:PASSWORD@HOST:PORT
# Ejemplo Redis local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Secreto para firmar las cookies (todos deben usar EL MISMO valor)
SESSION_SECRET=chatmsg_secreto_super_seguro_2024

# Origen permitido del frontend (URL donde corre el cliente)
CLIENT_ORIGIN=http://localhost:5173
